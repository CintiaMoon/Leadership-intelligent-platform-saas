              ],
              "path": [
                "api",
                "v1",
                "companies"
              ]
            },
            "description": "Verified, signed-in users only. You become the Owner; a role in the body is rejected. 5 per IP per hour and 10 per account per day.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Labs\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201',()=>pm.response.to.have.status(201));",
                  "const j=pm.response.json();",
                  "pm.test('Owner',()=>pm.expect(j.role).to.eql('OWNER'));",
                  "pm.collectionVariables.set('companyId',j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my companies",
