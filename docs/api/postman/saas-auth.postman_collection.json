{
  "info": {
    "name": "SaaS Platform API (SPEC-AUTH, SPEC-TEN)",
    "description": "Generated from contracts/openapi.yaml v0.1.0. Two folders. 'API direct' calls the API as the BFF would: it needs the X-BFF-Credential and an allowed Origin. Do not store the real credential in the collection; set it in a local environment. Cookie names depend on the profile: the `__Host-` names need HTTPS, so use the local overrides in apps/web/.env.example over plain HTTP.\n\n'BFF' calls the web app routes the browser uses and needs no credential. Order: Get CSRF token, Sign up, Verify email, Log in, Get CSRF token (session-bound), Get session, ... Log out.\n\nCompanies (SPEC-TEN) exist only in the 'API direct' folder: there is no BFF route yet (D-120). Run them after Log in and the session-bound CSRF token. Create a company stores companyId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "origin",
      "value": "http://localhost:3000"
    },
    {
      "key": "bffCredential",
      "value": "",
      "description": "Set locally; never commit."
    },
    {
      "key": "email",
      "value": "person@example.com"
    },
    {
      "key": "password",
      "value": "change-me-to-a-long-passphrase"
    },
    {
      "key": "newPassword",
      "value": "another-long-passphrase-123"
    },
    {
      "key": "displayName",
      "value": "Test Person"
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "webUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "webOrigin",
      "value": "http://localhost:3000",
      "description": "Must equal PUBLIC_BASE_URL of the web app, or state-changing requests get 403."
    },
    {
      "key": "companyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API direct (needs the BFF credential)",
      "item": [
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-BFF-Credential",
                "value": "{{bffCredential}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "csrf"
              ]
            },
            "description": "Run first, and again after login and logout. Stores csrfToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set('csrfToken',j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-BFF-Credential",
                "value": "{{bffCredential}}"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "signup"
              ]
            },
            "description": "Always 202, neutral. Limits: 5 per IP per hour, 3 per email per 24 hours.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"{{displayName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202',()=>pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-BFF-Credential",
                "value": "{{bffCredential}}"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "verify-email"
              ]
            },
            "description": "Take the token from the link in the email (Mailpit at http://localhost:8025). The token is after the # in the link.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 or 200',()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-BFF-Credential",
                "value": "{{bffCredential}}"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "verify-email",
                "resend"
              ]
            },
            "description": "Neutral response for any address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            }
          }
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-BFF-Credential",
                "value": "{{bffCredential}}"
              },
