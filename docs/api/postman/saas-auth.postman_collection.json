              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Sets the session cookie (Postman cookie jar). Fetch a new CSRF token afterwards.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get CSRF token (session-bound)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-BFF-Credential",
                "value": "{{bffCredential}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
