              ],
              "path": [
                "api",
                "auth",
                "csrf",
                "pre-login"
              ]
            },
            "description": "Pre-login token: the BFF drops the session cookie before asking the API. Stores csrfToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
