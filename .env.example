# Local development only. Copy to .env (git-ignored) and choose your own values.
# Never put production or shared-environment secrets in this file.
POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Backend (services/api) datasource; defaults match the values above.
DB_URL=jdbc:postgresql://localhost:5432/saas
DB_USERNAME=saas
DB_PASSWORD=change-me-local-only

# Backend security settings (SPEC-AUTH). Generate each secret with: openssl rand -base64 48
# Shared secret(s) that authenticate the BFF to the API; at most two (current and previous during rotation).
# Unset means every /api request is rejected.
BFF_CREDENTIALS=
# Required. Key for hashing rate-limit identifiers; the API will not start without it.
RATE_LIMIT_HMAC_KEY=
# Only these peers may supply X-Forwarded-For (comma-separated CIDRs): the subnet of the BFF. The loopback default
# below is accepted only with SPRING_PROFILES_ACTIVE=local (or test); any other profile refuses to start (D-95).
SPRING_PROFILES_ACTIVE=local
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Required. Signs pre-login CSRF tokens (D-75).
CSRF_HMAC_KEY=
# Required. Public address of the web app, used in email links (never taken from the Host header).
PUBLIC_BASE_URL=http://localhost:3000
# Origins the BFF may send in the Origin header (comma-separated); empty skips the check.
CSRF_ALLOWED_ORIGINS=http://localhost:3000
# Local HTTP development only: the __Host- cookie prefix needs HTTPS, so use a plain name and Secure=false.
CSRF_COOKIE_NAME=csrf
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false

# Email. Defaults point at Mailpit from infra/local/compose.yaml (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@liptech.io
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Web app / BFF (apps/web). It reads the same cookie names and public address as the API above.
# Address of the API as seen from the web server.
API_BASE_URL=http://localhost:8080
# Where the BFF takes the client address from (D-95): "cloudfront" (CloudFront-Viewer-Address) or "rightmost" (the last
# X-Forwarded-For entry, appended by the load balancer). The browser's own header is never forwarded as received.
CLIENT_IP_SOURCE=rightmost
# Name of the known-device cookie (D-99); same default on the API side (DEVICE_COOKIE_NAME).
DEVICE_COOKIE_NAME=device
# One of the values in BFF_CREDENTIALS (the API accepts two during rotation). Required at runtime.
BFF_CREDENTIAL=
